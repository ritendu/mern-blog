{
  "name": "mern-blog-backend",
  "version": "1.0.0",
  "description": "Backend for MERN blog system",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
